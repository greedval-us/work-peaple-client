# Read only by Electron main in development. Packaged app uses process environment.
# API, PostgreSQL and Redis run only on 192.168.0.102, not on this Windows client.
# Keep this target when forwarding over SSH (default SSH port 22):
# ssh -i "$HOME/.ssh/id_ed25519_hostkey" -p 22 -N -L 127.0.0.1:50051:127.0.0.1:50051 greed@192.168.0.102
# The existing private SSH key stays on this computer.
GRPC_TARGET=127.0.0.1:50051
# SSH encrypts the tunnel; enable gRPC TLS for a direct network connection.
GRPC_TLS_ENABLED=false
# Optional PEM CA file when TLS is enabled; leave empty for system trust roots.
GRPC_TLS_CA_PATH=
GRPC_TIMEOUT_MS=3000
